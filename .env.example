# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:FAKE-TOKEN-REPLACE-ME
TELEGRAM_WEBHOOK_SECRET=generate-a-random-string
FADE_ADMIN_USER_ID=0            # numeric Telegram user ID of the builder (kill switch auth)
FADE_BOT_USER_ID=0              # numeric Telegram user ID of the bot itself

# Polymarket
FADE_BUILDER_CODE=replace-with-registered-builder-code

# Chain / RPC
POLYGON_RPC_URL=https://polygon-rpc.com

# Database (SQLite for dev; Postgres URL in prod)
DATABASE_URL=sqlite+aiosqlite:///fade_dev.db
